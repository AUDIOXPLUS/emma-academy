{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.bat",
      "create_slim_json.js",
      "extract_emma_data.js",
      "build_standalone.js",
      "emma_academy_standalone.html",
      "README.txt",
      "CLAUDE.md",
      "firestore.rules",
      "EVENTS_SCHEMA.md"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(json|html|js|css|mp3|wav|ogg|png|jpg|jpeg|svg|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}
