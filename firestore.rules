rules_version = '2';

// EMMA Events — Firestore security rules, Phase 1.
// See EVENTS_SCHEMA.md for the collections planned across all phases.
//
// NOT deployed by this branch — the orchestrator/AXP deploys from the
// Firebase console or CI once reviewed.

service cloud.firestore {
  match /databases/{database}/documents {

    // judges/{code}: the access code IS the document id (see
    // SPEC_EVENTS_v1.2, decision #1 — "possession of the code = identity").
    // - get: allowed to any authenticated user (anonymous auth included),
    //   so the app can look up the code the person just typed.
    // - list: denied, so the collection can't be enumerated to harvest
    //   valid codes.
    // - writes: denied from the client for Phase 1. Judge/admin docs are
    //   created and edited from the Firebase console by hand until the
    //   back office (Phase 2) takes this over.
    match /judges/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Everything else (events, competitors, registrations, evaluations, ...):
    // default deny. Opened up collection-by-collection in later phases as
    // each flow is built and its rules are actually specified.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
